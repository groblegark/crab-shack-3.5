{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://groblegark.github.io/crab-shack-3.5/cultureway.schema.json",
 "title": "Cultureway document, schema 2",
 "description": "One culture as data. Additive over the shipped v1 shape (tools/fixtures/cultures-pig.json); unknown sections are ignored by the engine (forward-compat by construction). Authoritative clamps live in game.js cultureProblem - this schema mirrors them for authoring-time validation and MUST NOT be looser.",
 "type": "object",
 "required": [
  "meta",
  "people",
  "art"
 ],
 "additionalProperties": true,
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "id",
    "name",
    "ver"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,15}$"
    },
    "name": {
     "type": "string",
     "maxLength": 40
    },
    "ver": {
     "type": "integer",
     "minimum": 1
    },
    "schema": {
     "type": "integer",
     "const": 2
    }
   }
  },
  "people": {
   "type": "object",
   "required": [
    "names"
   ],
   "properties": {
    "names": {
     "type": "array",
     "minItems": 1,
     "maxItems": 40,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
     }
    }
   }
  },
  "art": {
   "type": "object",
   "required": [
    "palette",
    "colorways",
    "body"
   ],
   "properties": {
    "palette": {
     "type": "object",
     "maxProperties": 16,
     "propertyNames": {
      "minLength": 1,
      "maxLength": 1
     },
     "additionalProperties": {
      "$ref": "#/$defs/rgb"
     }
    },
    "colorNames": {
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 20
     }
    },
    "colorways": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "object",
      "additionalProperties": {
       "$ref": "#/$defs/rgb"
      }
     }
    },
    "body": {
     "type": "object",
     "required": [
      "w",
      "h",
      "slots",
      "anchors",
      "poses"
     ],
     "properties": {
      "w": {
       "type": "integer",
       "minimum": 4,
       "maximum": 32
      },
      "h": {
       "type": "integer",
       "minimum": 4,
       "maximum": 32
      },
      "slots": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "maxLength": 1
       }
      },
      "anchors": {
       "type": "object",
       "required": [
        "hat",
        "carry",
        "mark",
        "bar"
       ],
       "properties": {
        "hat": {
         "$ref": "#/$defs/xy"
        },
        "carry": {
         "$ref": "#/$defs/xy"
        },
        "mark": {
         "$ref": "#/$defs/xy"
        },
        "bar": {
         "type": "object",
         "required": [
          "w"
         ],
         "properties": {
          "w": {
           "type": "integer",
           "minimum": 1,
           "maximum": 32
          }
         }
        }
       }
      },
      "poses": {
       "type": "object",
       "required": [
        "a",
        "b",
        "w",
        "s"
       ],
       "additionalProperties": {
        "$ref": "#/$defs/rows"
       }
      }
     }
    },
    "accessories": {
     "type": "object",
     "maxProperties": 8,
     "additionalProperties": {
      "type": "object",
      "required": [
       "dx",
       "dy",
       "rows"
      ],
      "properties": {
       "dx": {
        "type": "integer",
        "minimum": -16,
        "maximum": 16
       },
       "dy": {
        "type": "integer",
        "minimum": -16,
        "maximum": 16
       },
       "rows": {
        "$ref": "#/$defs/rows"
       }
      }
     }
    },
    "items": {
     "type": "object",
     "maxProperties": 16,
     "additionalProperties": {
      "type": "object",
      "required": [
       "rows"
      ],
      "properties": {
       "rows": {
        "$ref": "#/$defs/rows"
       }
      }
     }
    },
    "bather": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
       "type": "integer"
      }
     }
    }
   }
  },
  "world": {
   "type": "object",
   "description": "PLACE art - reserved (accepted and ignored until the renderer exists). Backdrop layers, terrain, building templates, props, lighting."
  },
  "voice": {
   "type": "object",
   "required": [
    "registers"
   ],
   "properties": {
    "registers": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "type": "object",
      "required": [
       "id",
       "acc"
      ],
      "properties": {
       "id": {
        "type": "string",
        "maxLength": 16
       },
       "acc": {
        "type": "string",
        "maxLength": 16
       },
       "purseMul": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 1.5
       },
       "diary": {
        "$ref": "#/$defs/lines38"
       },
       "depart": {
        "$ref": "#/$defs/lines50"
       },
       "dossier": {
        "type": "array",
        "maxItems": 6,
        "items": {
         "$ref": "#/$defs/line50"
        }
       },
       "foreign": {
        "$ref": "#/$defs/line50"
       },
       "refuseHire": {
        "$ref": "#/$defs/line50"
       }
      }
     }
    }
   }
  },
  "appeal": {
   "description": "THE ONE TABLE for what draws this people: standing taste weights and the drop-nudge terms together. Top-level `tastes` is gone; a document that still carries it fails loudly at install.",
   "type": "object",
   "properties": {
    "tastes": {
     "description": "Per-recipe multiplier, 1.0 when unstated. Below 1 is dislike, 0.1 is effectively taboo.",
     "type": "object",
     "maxProperties": 64,
     "additionalProperties": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5.0
     }
    },
    "nudge": {
     "description": "Drop-nudge terms in AUTHOR units, converted once at install: radius in px, minutes on the game clock, relax quantized to the sim's Q20 grid by the same quantizer the engine's own constant uses, mul100 in appeal's hundredths (130 = x1.3). Fields left out inherit the crab values (72 / 60 / 0.12 / 130).",
     "type": "object",
     "properties": {
      "radius": {
       "type": "integer",
       "minimum": 8,
       "maximum": 128
      },
      "minutes": {
       "type": "integer",
       "minimum": 5,
       "maximum": 1440
      },
      "relax": {
       "type": "number",
       "minimum": 0,
       "maximum": 0.5
      },
      "mul100": {
       "type": "integer",
       "minimum": 100,
       "maximum": 300
      }
     }
    }
   }
  },
  "management": {
   "description": "The culture's working norms, in AUTHOR units converted once at install. tableTip is what a guest of this people leaves on the table, in whole dollars (crab: 9); counter20 is the jar's token share of that tip at the counter, in twentieths (crab: 3 = the old 0.15); shifts shape their working day in half-hour minutes - std is the M/E standard day (crab: 360), day the owner-operator's open-to-close cap (crab: 600), cover the covering double (crab: 720). Fields left out inherit the crab values. The town's WAGE_STD is deliberately NOT here: it is the town's arithmetic grid, and a culture's customary wage joins this section in the settlers slice, when someone exists to read it.",
   "type": "object",
   "properties": {
    "tableTip": { "type": "integer", "minimum": 1, "maximum": 30 },
    "counter20": { "type": "integer", "minimum": 0, "maximum": 20 },
    "shifts": {
     "type": "object",
     "properties": {
      "std": { "type": "integer", "minimum": 120, "maximum": 720, "multipleOf": 30 },
      "day": { "type": "integer", "minimum": 240, "maximum": 840, "multipleOf": 30 },
      "cover": { "type": "integer", "minimum": 240, "maximum": 1440, "multipleOf": 30 }
     }
    }
   }
  },
  "settlers": {
   "description": "Phase B (debt items 2-3): may this people STAY? apron: a visitor of this culture accepts a job offer and converts to a resident through the persona factory, keeping her name, face, hat and culture - the settled resident works shifts, draws wages and sleeps in town housing exactly as crab crew do (drawn from her own document's tables; poses the document lacks fall back to the walk frames). Default false: her register's refuseHire line stands. walkins: this people's share of anonymous walk-ins and migrated-save seeding, in TWENTIETHS (0-8; 0 = never, the default and byte-identical to today - the roll is skipped entirely, no draw). Ownership of a declared business binds to a settler in a later slice.",
   "type": "object",
   "properties": {
    "apron": { "type": "boolean" },
    "walkins": { "type": "integer", "minimum": 0, "maximum": 8 }
   }
  },
  "cards": {
   "description": "Phase D (declarative cards): dossier cards a culture declares, up to 4. Each binds row labels to REGISTERED observables - the same versioned registry brains declare inputs from (need.thirst.q20, wallet.cents, ...). The first card renders on the visitor dossier with live values; an unknown observable is refused by name at import. Data reading data: no code, no draws, view-only.",
   "type": "array",
   "maxItems": 4,
   "items": {
    "type": "object",
    "required": ["title", "rows"],
    "properties": {
     "title": { "type": "string", "minLength": 1, "maxLength": 18 },
     "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": "object",
       "required": ["label", "obs"],
       "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 10 },
        "obs": { "type": "string", "description": "a registered observable name; the engine validator is the authority on the live set" }
       }
      }
     }
    }
   }
  },
  "arrival": {
   "type": "object",
   "properties": {
    "repGate": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "shareMax": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.5
    },
    "shareRamp": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    }
   }
  },
  "foodways": {
   "type": "object",
   "description": "Phase B (LIVE 2026-08-22): dishes in BIZ-shaped rows a kitchen here can LEARN - author-side whole dollars crossing the cents boundary at load, ingredients priced through the import machinery (nothing conjured), items carrying their own 9-wide pixel art on the global palette. The demand must be TAUGHT (a departure card with a foreign settle) before the manage card offers the lesson.",
   "additionalProperties": false,
   "properties": {
    "ingredients": {
     "type": "object",
     "description": "A culture's own priced imports, joining the pier's list at install (author whole dollars per unit; the cent is born at ingredientCost). May not re-price the native pantry (fish_raw, fruit, token, soap, linen) nor an ingredient another installed culture already priced. Max 16.",
     "maxProperties": 16,
     "additionalProperties": false,
     "patternProperties": {
      "^[a-z][a-z0-9_]{0,23}$": {
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      }
     }
    },
    "dishes": {
     "type": "array",
     "maxItems": 32,
     "items": {
      "type": "object",
      "required": [
       "id",
       "biz",
       "icon",
       "pay",
       "raw",
       "steps"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24,
        "description": "must not shadow the house menu's own recipe ids"
       },
       "biz": {
        "type": "string",
        "maxLength": 12,
        "description": "a kitchen business that exists; every step's station must exist there"
       },
       "icon": {
        "type": "string",
        "maxLength": 24,
        "description": "a native item or one declared in items{} with art"
       },
       "pay": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "author dollars; the cent is born at menuPrice"
       },
       "learn": {
        "type": "integer",
        "minimum": 0,
        "maximum": 500,
        "description": "one-time lesson fee in author dollars (0 = free)"
       },
       "raw": {
        "type": "string",
        "maxLength": 12,
        "description": "an ingredient the trade machinery prices (INGREDIENT_COST)"
       },
       "steps": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
         "type": "array",
         "minItems": 3,
         "maxItems": 3,
         "prefixItems": [
          {
           "type": "string",
           "description": "station at the dish's biz"
          },
          {
           "type": "number",
           "minimum": 0.5,
           "maximum": 30,
           "description": "seconds"
          },
          {
           "type": "string",
           "maxLength": 24,
           "description": "item carried out of the step"
          }
         ]
        }
       }
      }
     }
    },
    "items": {
     "type": "object",
     "maxProperties": 64,
     "description": "display names + optional 9-wide pixel art (global palette chars, '.' transparent); may not shadow the native pantry",
     "additionalProperties": {
      "type": "object",
      "required": [
       "name"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 18
       },
       "art": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 12
        }
       }
      }
     }
    }
   }
  },
  "businesses": {
   "type": "object",
   "description": "Phase B (FORMAT LIVE 2026-08-22): whole shops a culture declares - catalog SUBSTANCE only (recipes, stations as TYPE+capacity, economics in author dollars). Never map coordinates (placement is the town's, phase D) and never an owner (ownership binds to a settler when settlers exist). A declared business is built and PENDING - inspectable, not placed - until a plot exists. Max 4.",
   "maxProperties": 4,
   "additionalProperties": false,
   "patternProperties": {
    "^[a-z][a-z0-9_]{0,11}$": {
     "type": "object",
     "required": [
      "name",
      "short",
      "sign",
      "kind",
      "rent",
      "stations",
      "source",
      "out",
      "recipes"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1,
       "maxLength": 18
      },
      "short": {
       "type": "string",
       "minLength": 1,
       "maxLength": 6
      },
      "sign": {
       "type": "string",
       "minLength": 1,
       "maxLength": 18
      },
      "kind": {
       "enum": [
        "palapa",
        "shopfront"
       ],
       "description": "one of the town building templates; a new kind needs world art first (the world section, reserved)"
      },
      "rent": {
       "type": "integer",
       "minimum": 1,
       "maximum": 500,
       "description": "author dollars per day; cents at build"
      },
      "wage": {
       "type": "integer",
       "minimum": 10,
       "maximum": 100,
       "description": "this shop's advertised wage in author dollars; omitted = the town rate (WAGE_STD) when placed"
      },
      "lodging": {
       "type": "boolean",
       "description": "stalls are ROOMS kept until morning (the hotel bit)"
      },
      "sellable": {
       "type": "boolean",
       "description": "grows an OFFER chip when placed and NPC-owned"
      },
      "stations": {
       "type": "object",
       "description": "station TYPE -> working capacity (1-4). Coordinates are the town map, never the culture.",
       "minProperties": 1,
       "maxProperties": 6,
       "additionalProperties": false,
       "patternProperties": {
        "^[a-z][a-z0-9_]{0,9}$": {
         "type": "integer",
         "minimum": 1,
         "maximum": 4
        }
       }
      },
      "stalls": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8,
       "description": "occupiable facilities (shower/room cycle), count only"
      },
      "tables": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8,
       "description": "dining seats, count only"
      },
      "source": {
       "type": "string",
       "description": "the station where raws enter; must be one of stations"
      },
      "out": {
       "type": "string",
       "description": "the pass; must be one of stations"
      },
      "recipes": {
       "type": "array",
       "minItems": 1,
       "maxItems": 8,
       "items": {
        "type": "object",
        "required": [
         "id",
         "icon",
         "pay",
         "raw",
         "steps"
        ],
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "must not shadow the house menu's own recipe ids"
         },
         "icon": {
          "type": "string",
          "maxLength": 24,
          "description": "a native item or one declared in items{} with art"
         },
         "pay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "author dollars; the cent is born at menuPrice"
         },
         "learn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500,
          "description": "one-time lesson fee in author dollars (0 = free)"
         },
         "raw": {
          "type": "string",
          "maxLength": 12,
          "description": "an ingredient the trade machinery prices (INGREDIENT_COST)"
         },
         "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
           "type": "array",
           "minItems": 3,
           "maxItems": 3,
           "prefixItems": [
            {
             "type": "string",
             "description": "station at the dish's biz"
            },
            {
             "type": "number",
             "minimum": 0.5,
             "maximum": 30,
             "description": "seconds"
            },
            {
             "type": "string",
             "maxLength": 24,
             "description": "item carried out of the step"
            }
           ]
          }
         }
        },
        "description": "The BIZ recipe shape, validated by the same recipeRowProblem as foodway dishes; steps' stations resolve against this business's own declared stations."
       }
      }
     }
    }
   }
  },
  "management": {
   "type": "object",
   "description": "Phase B (proposal): the culture's norms - wage/tip/shift/meal-policy defaults."
  },
  "conduct": {
   "type": "object",
   "description": "Layer-0 rule table (proposal); Layer-1 expressions join per-field when a rule needs a formula.",
   "properties": {
    "hireable": {
     "type": "boolean"
    },
    "tabooFloor": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 1.0
    },
    "foreignThreshold": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 1.0
    }
   }
  },
  "civics": {
   "type": "object",
   "description": "Phase E - institutions, offices, policy step-tables, calendar phases, errand defs, invariants. Schema lands with the capability APIs."
  },
  "depart": {
   "type": "object",
   "additionalProperties": false,
   "description": "Departure-card rule re-weighting (registry row 4). weights: ruleId -> integer 0..8, a QUARTERS multiplier on the engine's rule weight (4 = identity, 0 = silence the rule for this people, 8 = twice as loud). Unknown rule ids are refused at import.",
   "properties": {
    "weights": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "rough": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "quits": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "quit": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "nothing": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "foreign": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "delight": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "unspent": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "idle": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "hungry": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "parched": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "grubby": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "weary": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "bored": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "wait": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "dues": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "missed": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "mist": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "table": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "bed": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "spentup": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "top": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "regular": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "quiet": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      }
     }
    }
   }
  }
 },
 "$defs": {
  "rgb": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "integer",
    "minimum": 0,
    "maximum": 255
   }
  },
  "xy": {
   "type": "object",
   "required": [
    "x",
    "y"
   ],
   "properties": {
    "x": {
     "type": "integer"
    },
    "y": {
     "type": "integer"
    }
   }
  },
  "rows": {
   "type": "array",
   "minItems": 1,
   "maxItems": 32,
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 32
   }
  },
  "line50": {
   "type": "string",
   "maxLength": 50,
   "pattern": "^[^\"]*$"
  },
  "lines38": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "maxLength": 38,
    "pattern": "^[^\"]*$"
   }
  },
  "lines50": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "maxLength": 50,
    "pattern": "^[^\"]*$"
   }
  }
 }
}
