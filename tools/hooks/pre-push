#!/bin/sh
# tools/hooks/pre-push — the receipt gate, mechanized (task kd-GNL3o76EhB).
#
# THE HOLE THIS FILLS. Nothing in the push path ever asked whether the tree
# being pushed to main owns a gate verdict. The gate was a CONVENTION: run the
# cluster suite, then merge. The convention's own author pushed 8926e7c — the
# commit that TIGHTENED the kube policy — WITHOUT gating it (kd-IHhEW6zDu2). If
# the agent most focused on the gate can miss it, prose cannot be the mechanism.
# This hook is the mechanism: it fires at the exact moment of the mistake, a
# `git push` that would land an UNGATED gameplay change on main, and refuses it.
#
# WHAT IT DECIDES ON. It does not re-run the suite (that is a 7-minute cluster
# job, not a pre-push check). It asks tools/gatecheck.mjs — pure git plumbing,
# sub-second — whether the pushed tip already OWNS (GREEN) or INHERITS (AMBER) a
# gate verdict, or LACKS one (RED). See that tool's header for the three states.
#
#   GREEN / AMBER  -> allow. AMBER means the 11 gate-relevant files are
#                    byte-identical to a gated ancestor, so a stamp/tooling/
#                    receipt-only push carries a verdict forward on EVIDENCE.
#   RED            -> REFUSE. A gate-relevant file changed and no receipt's
#                    verdict reaches this tree. This is the ungated-gameplay
#                    push the hole let through.
#
# WHY NO ESCAPE HATCH. The bead that scoped this feared a hook would misfire on
# doc/receipt pushes and get ripped out, so it wanted a --force-with-reason
# hatch — "the thing most likely to be abused." gatecheck's AMBER state retires
# that fear by construction: a receipt or stamp commit does not touch the 11
# gate files, so it reads AMBER and is never refused. There is nothing to
# hatch, so there is no hatch to abuse. This hook refuses ONLY on RED.
#
# WHY IT FAILS OPEN ON A BROKEN CHECKER. If gatecheck cannot produce a verdict
# at all — node missing, the tool moved, a crash — this hook WARNS loudly and
# ALLOWS the push. A checker that blocks every push (receipts, docs, its own
# installation) the moment node hiccups is exactly the misfire that gets a hook
# disabled, and then we are worse off than with no hook. It fails closed on a
# real RED (the mistake it exists to catch) and open on its own breakage (a
# separate bug to fix, loudly surfaced, not a reason to wedge the whole fleet).
#
# ONLY MAIN. Feature-branch pushes are never gated — you gate a branch, then
# merge it. So the hook acts only on refs whose REMOTE side is refs/heads/main.
#
# THE SECOND CHECK: DOES THE STAMP MISNAME THE BYTES A PLAYER GETS?
# (bug kd-c7tbNghG7k, criterion corrected here — see below.)
#
# version.js is runtime-loaded at index.html:87 regardless of what a merge
# touched, so a push can change the build a player is served. Neither existing
# surface can ask whether the stamp still matches, both for CORRECT reasons the
# bead spells out: the suite checks the stamp's SHAPE, not its identity
# (sha-equality with HEAD is impossible by construction — committing the stamp
# moves the sha), and gatecheck DELIBERATELY excludes version.js so a stamp-only
# push can read AMBER. This hook is the only place the question can be asked.
#
# WHAT THIS DOES *NOT* CHECK, AND WHY — the correction. The obvious test is
# "does the stamp name the tip's parent?" That test is WRONG, and measuring it
# against real history is how we found out: it fires on 5 of 5 receipt-only
# pushes (8927f76, d595ecd, f3cae72, 8772d67, ab82f69). A receipt push changes
# no file index.html loads, so its stamp is not misnaming anything a player can
# see — the warning would be pure noise on the exact case the scoping bead
# feared ("the thing most likely to be abused"), and a noisy hook gets deleted.
#
# So the criterion is PLAYER-SERVED BYTES, taken from index.html's own load
# list: if the tree the stamp NAMES and the tree being PUSHED are identical
# across those files, the stamp is honest no matter which commit it names.
# Measured over main's last 40 first-parent commits, this reads 4 hits where the
# parent test read 12 — and all 4 are real merges whose stamp landed seconds
# later (8s, 17s, 26s), i.e. correctly-followed ritual caught mid-sequence.
#
# WARNS, DOES NOT REFUSE, and refusing would be actively wrong here: the fix for
# a stale stamp is itself a push, so refusing wedges the repair. A stale stamp
# also ships a CORRECT game under a wrong name — bad, but categorically not the
# ungated-gameplay push this hook exists to refuse.
#
# INSTALL. A hook in .git/hooks is not version-controlled and not installed by
# cloning, so it would protect one workstation and no fresh pod — theatre. This
# file lives IN the repo and is wired up by `git config core.hooksPath
# tools/hooks`. tools/mkversion.mjs (run at every merge ritual, immediately
# before every push to main) self-installs that config if it is unset, so any
# agent about to push main has already crossed the install path. To wire it by
# hand: `git config core.hooksPath tools/hooks`.

set -u

TARGET="refs/heads/main"
ZERO="0000000000000000000000000000000000000000"

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$toplevel" || exit 0

if ! command -v node >/dev/null 2>&1; then
  printf '\npre-push WARNING: node not found — the receipt gate cannot run. Push allowed.\n\n' >&2
  exit 0
fi

refused=0

# stdin carries one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # Only guard pushes that land on main.
  [ "$remote_ref" = "$TARGET" ] || continue
  # A branch deletion pushes the zero sha on the local side — nothing to gate.
  [ "$local_sha" = "$ZERO" ] && continue

  short=$(git rev-parse --short "$local_sha" 2>/dev/null || echo "$local_sha")

  # </dev/null so gatecheck cannot consume the remaining ref lines on our stdin.
  out=$(node tools/gatecheck.mjs --ref "$local_sha" </dev/null 2>&1)
  rc=$?
  verdict=$(printf '%s\n' "$out" | head -n1 | awk '{print $1}')

  case "$verdict" in
    GREEN | AMBER)
      : # tip owns or inherits a gate verdict — allow.
      ;;
    RED)
      printf '\n' >&2
      printf 'PRE-PUSH REFUSED: %s is UNGATED for a push to main.\n' "$short" >&2
      printf '%s\n' "$out" | sed 's/^/  /' >&2
      printf '\n' >&2
      printf 'Gate it on the cluster before landing (per KUBE POLICY):\n' >&2
      printf '  node tools/kube.mjs run experiments/suite-330.json --ref %s --wait\n' "$short" >&2
      printf 'A stamp/tooling/receipt-only push reads AMBER and is NOT refused.\n\n' >&2
      refused=1
      ;;
    *)
      # No verdict word: gatecheck crashed / is missing / was moved. Fail OPEN,
      # loudly — do not wedge every push on a broken checker (see header).
      printf '\npre-push WARNING: gatecheck produced no verdict (exit %s) for %s — NOT gating this push.\n' "$rc" "$short" >&2
      printf '%s\n' "$out" | sed 's/^/  /' >&2
      printf 'The receipt gate is OFF until tools/gatecheck.mjs runs again. Push allowed.\n\n' >&2
      ;;
  esac

  # --- SECOND CHECK: does the stamp misname the player's bytes? -----------
  # PLAYER_SERVED is index.html's own load list (the <script src>/<link href>
  # set, minus version.js itself and the data: favicon). If this list and
  # index.html ever drift apart, this check quietly narrows — so it is asserted
  # by the suite scenario "the stamp names the bytes a player gets".
  PLAYER_SERVED="index.html font.js ppu.js sprites.js crabs.js merge.js game.js cultureways.js tools/kernel/kernel-b64.js"

  # Read the stamp out of the PUSHED tree, not the worktree: the worktree may be
  # dirty or on another branch, and it is the pushed bytes that reach a player.
  stamped=$(git show "$local_sha:version.js" 2>/dev/null \
            | sed -n 's/.*sha: "\([0-9a-f]\{7,\}\)".*/\1/p' | head -n1)

  if [ -z "$stamped" ]; then
    printf '\npre-push WARNING: %s has no readable stamp in version.js — run node tools/mkversion.mjs.\n\n' "$short" >&2
  elif ! git cat-file -e "$stamped^{commit}" 2>/dev/null; then
    # The stamp names a commit this repo does not have (rewritten history, or a
    # hand-edited stamp). Cannot compare trees; say so rather than guess.
    printf '\npre-push WARNING: the stamp on %s names %s, which is not a commit in this repo.\n\n' "$short" "$stamped" >&2
  else
    drift=$(git diff --name-only "$stamped" "$local_sha" -- $PLAYER_SERVED 2>/dev/null | tr '\n' ' ')
    if [ -n "$drift" ]; then
      printf '\n' >&2
      printf 'pre-push WARNING: the stamp on %s is STALE for the bytes a player gets.\n' "$short" >&2
      printf '  stamp names: %s\n' "$stamped" >&2
      printf '  but these player-served files differ from that build: %s\n' "$drift" >&2
      printf 'The title screen will misreport this build and its age (bug kd-c7tbNghG7k).\n' >&2
      printf 'Fix before pushing:\n' >&2
      printf '  node tools/mkcultureways.mjs && node tools/mkversion.mjs\n' >&2
      printf '  git add version.js && git commit -m "the stamp names <what landed> (%s)"\n' "$short" >&2
      printf 'Push allowed — a stale stamp misnames a correct build; it does not ship an ungated one.\n\n' >&2
    fi
  fi
done

exit $refused
