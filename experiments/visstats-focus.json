{
  "name": "visstats-focus",
  "note": "The visitor-stats slice's own scenarios (the Q20 meter fix and the arrival band), both backends - the cheap targeted gate for green checks and mutation demos. Full suite + phased-gates still run on the final SHA.",
  "resources": {
    "requests": { "cpu": "2", "memory": "6Gi" },
    "limits": { "cpu": "2", "memory": "8Gi" }
  },
  "arms": [
    {
      "id": "js-visstats",
      "entry": "tools/suite.mjs",
      "args": ["meters speak", "boat lands"],
      "env": { "SIMLIB_REALM": "main" }
    },
    {
      "id": "wasm-visstats",
      "entry": "tools/suite.mjs",
      "args": ["meters speak", "boat lands"],
      "env": { "SIMLIB_REALM": "main", "SIMLIB_KERNEL": "wasm" }
    }
  ],
  "nodeSelector": { "karpenter.sh/nodepool": "ephemeral-pool" },
  "tolerations": [
    { "key": "gasboat.ephemeral", "operator": "Equal", "value": "true", "effect": "NoSchedule" }
  ]
}
