{
  "name": "e6-focus",
  "note": "Phase E6's own scenarios (crab-as-document: names, shells, the diary tripwire, hostile rows), both backends - the cheap targeted gate for green checks and mutation demos. Full suite + phased-gates still run on the final SHA.",
  "resources": {
    "requests": { "cpu": "2", "memory": "6Gi" },
    "limits": { "cpu": "2", "memory": "8Gi" }
  },
  "arms": [
    {
      "id": "js-e6",
      "entry": "tools/suite.mjs",
      "args": ["crab-as-document:"],
      "env": { "SIMLIB_REALM": "main" }
    },
    {
      "id": "wasm-e6",
      "entry": "tools/suite.mjs",
      "args": ["crab-as-document:"],
      "env": { "SIMLIB_REALM": "main", "SIMLIB_KERNEL": "wasm" }
    }
  ],
  "nodeSelector": { "karpenter.sh/nodepool": "ephemeral-pool" },
  "tolerations": [
    { "key": "gasboat.ephemeral", "operator": "Equal", "value": "true", "effect": "NoSchedule" }
  ]
}
