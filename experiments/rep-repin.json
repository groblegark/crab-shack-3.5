{
  "name": "rep-repin",
  "note": "The reputation pass's re-pin diagnostic: the seven scenarios the clean battery reddened, both backends, on the tree with gates translated + stagings walked + three pins pointed. Greens here earn the final full battery.",
  "resources": {
    "requests": { "cpu": "2", "memory": "6Gi" },
    "limits": { "cpu": "2", "memory": "8Gi" }
  },
  "arms": [
    {
      "id": "js-repin",
      "entry": "tools/suite.mjs",
      "args": ["a save without cultures", "defaults are behavior-identical", "draw count per day", "buys the Driftwood", "leaves the town in a sane state", "they actually get off the boat", "thinking heads round-trips"],
      "env": { "SIMLIB_REALM": "main" }
    },
    {
      "id": "wasm-repin",
      "entry": "tools/suite.mjs",
      "args": ["a save without cultures", "defaults are behavior-identical", "draw count per day", "buys the Driftwood", "leaves the town in a sane state", "they actually get off the boat", "thinking heads round-trips"],
      "env": { "SIMLIB_REALM": "main", "SIMLIB_KERNEL": "wasm" }
    }
  ],
  "nodeSelector": { "karpenter.sh/nodepool": "ephemeral-pool" },
  "tolerations": [
    { "key": "gasboat.ephemeral", "operator": "Equal", "value": "true", "effect": "NoSchedule" }
  ]
}
