{
 "name": "u1-workpause-cal",
 "note": "U1 calibration with the work-pause model (--citworkpause: drain paused while on duty). GROWTH pillar target ~24/48, BASELINE floor 0/48 (pre-U1). Sweeps CIT_DECAY_MUL {4,5,6,8} x growth x 3 blocks + baseline at {5,6}. batch sets kernel=wasm realm=main.",
 "resources": {
  "requests": {
   "cpu": "7",
   "memory": "2Gi"
  },
  "limits": {
   "cpu": "8",
   "memory": "4Gi"
  }
 },
 "nodeSelector": {
  "karpenter.sh/nodepool": "ephemeral-pool"
 },
 "tolerations": [
  {
   "key": "gasboat.ephemeral",
   "operator": "Equal",
   "value": "true",
   "effect": "NoSchedule"
  }
 ],
