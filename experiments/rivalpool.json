{
  "name": "rivalpool",
  "note": "The twelve-town price pool with its _novsep control - six arms, three prices x parting-on/parting-off. Run against BOTH the green tree and the float-aim tree: if the fix genuinely thinned the cheap end the damage survives in the live columns on the fix tree alone; if it re-rolled the pool, the _novsep columns agree across trees. The suite's own note is the authority for this instrument and for its verdict rule: do not widen K.",
  "resources": {
    "requests": { "cpu": "2", "memory": "6Gi" },
    "limits": { "cpu": "2", "memory": "8Gi" }
  },
  "arms": [
    { "id": "dear",         "entry": "tools/rivalpool.mjs", "args": ["--mul", "1.3"],            "env": { "SIMLIB_REALM": "main" } },
    { "id": "mid",          "entry": "tools/rivalpool.mjs", "args": ["--mul", "1.0"],            "env": { "SIMLIB_REALM": "main" } },
    { "id": "cheap",        "entry": "tools/rivalpool.mjs", "args": ["--mul", "0.7"],            "env": { "SIMLIB_REALM": "main" } },
    { "id": "dear-novsep",  "entry": "tools/rivalpool.mjs", "args": ["--mul", "1.3", "--novsep"], "env": { "SIMLIB_REALM": "main" } },
    { "id": "mid-novsep",   "entry": "tools/rivalpool.mjs", "args": ["--mul", "1.0", "--novsep"], "env": { "SIMLIB_REALM": "main" } },
    { "id": "cheap-novsep", "entry": "tools/rivalpool.mjs", "args": ["--mul", "0.7", "--novsep"], "env": { "SIMLIB_REALM": "main" } }
  ],
  "nodeSelector": {
    "karpenter.sh/nodepool": "ephemeral-pool"
  },
  "tolerations": [
    {
      "key": "gasboat.ephemeral",
      "operator": "Equal",
      "value": "true",
      "effect": "NoSchedule"
    }
  ]
}
