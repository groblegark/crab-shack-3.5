{
  "name": "rethink-pins",
  "note": "The two pins interruptible commitment moves - the rng draw-count (new gather sites) and the frozen day-2 fingerprint (guests act sooner). Run RED first to harvest the new values from the failure strings, re-pin with the ledger entry, run again green.",
  "resources": {
    "requests": { "cpu": "2", "memory": "6Gi" },
    "limits": { "cpu": "2", "memory": "8Gi" }
  },
  "arms": [
    {
      "id": "js-pins",
      "entry": "tools/suite.mjs",
      "args": ["rng: the sim stream", "defaults are behavior-identical"],
      "env": { "SIMLIB_REALM": "main" }
    },
    {
      "id": "wasm-pins",
      "entry": "tools/suite.mjs",
      "args": ["rng: the sim stream", "defaults are behavior-identical"],
      "env": { "SIMLIB_REALM": "main", "SIMLIB_KERNEL": "wasm" }
    }
  ],
  "nodeSelector": { "karpenter.sh/nodepool": "ephemeral-pool" },
  "tolerations": [
    { "key": "gasboat.ephemeral", "operator": "Equal", "value": "true", "effect": "NoSchedule" }
  ]
}
