{
  "name": "rhythm-focus",
  "note": "The rhythm R0-R2 slice's own scenarios, both backends - the cheap targeted gate for green checks and mutation demos. Full suite-318 + phased-gates still run on the final SHA.",
  "resources": {
    "requests": { "cpu": "2", "memory": "6Gi" },
    "limits": { "cpu": "2", "memory": "8Gi" }
  },
  "arms": [
    {
      "id": "js-rhythm",
      "entry": "tools/suite.mjs",
      "args": ["rhythm:"],
      "env": { "SIMLIB_REALM": "main" }
    },
    {
      "id": "wasm-rhythm",
      "entry": "tools/suite.mjs",
      "args": ["rhythm:"],
      "env": { "SIMLIB_REALM": "main", "SIMLIB_KERNEL": "wasm" }
    }
  ],
  "nodeSelector": { "karpenter.sh/nodepool": "ephemeral-pool" },
  "tolerations": [
    { "key": "gasboat.ephemeral", "operator": "Equal", "value": "true", "effect": "NoSchedule" }
  ]
}
