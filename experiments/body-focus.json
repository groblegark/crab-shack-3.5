{
  "name": "body-focus",
  "note": "The body slice's targeted gate: the three 'the body:' scenarios on both backends - the cheap manifest the green check and the mutation demos run through (a mutation demo EXPECTS a red arm; read the receipts, not the Job status).",
  "resources": {
    "requests": { "cpu": "2", "memory": "6Gi" },
    "limits": { "cpu": "2", "memory": "8Gi" }
  },
  "arms": [
    {
      "id": "body-js",
      "entry": "tools/suite.mjs",
      "args": ["the body:"],
      "env": { "SIMLIB_REALM": "main" }
    },
    {
      "id": "body-wasm",
      "entry": "tools/suite.mjs",
      "args": ["the body:"],
      "env": { "SIMLIB_REALM": "main", "SIMLIB_KERNEL": "wasm" }
    }
  ],
  "nodeSelector": { "karpenter.sh/nodepool": "ephemeral-pool" },
  "tolerations": [
    { "key": "gasboat.ephemeral", "operator": "Equal", "value": "true", "effect": "NoSchedule" }
  ]
}
